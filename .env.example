APP_CALENDAR_TIMEZONE=Asia/Manila
APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Local development only. Production must use APP_ENV=production and APP_DEBUG=false.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Push job/worker timeout: 60 seconds; reservation retry must stay above that.
DB_QUEUE_RETRY_AFTER=90

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Optional private R2 disks; existing uploads continue to use local storage.
# Opt in with r2_media; public safely restores local NEW media uploads.
LIFEFLOW_MEDIA_DISK=public
# Optional private proof cutover; proofs restores local NEW uploads without changing reads.
LIFEFLOW_PROOF_DISK=proofs
# Optional private proof cutover; proofs restores local NEW uploads without changing reads.
LIFEFLOW_PROOF_DISK=proofs
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_MEDIA_BUCKET=lifeflow-media
R2_PROOFS_BUCKET=lifeflow-proofs

VITE_APP_NAME="${APP_NAME}"





# Direct Android FCM HTTP v1; leave disabled until server setup is complete.
# FCM_PROJECT_ID must match the Android google-services.json project_info.project_id.
# FCM_CREDENTIALS is an absolute readable path to a Firebase service-account JSON
# file, NOT inline JSON and NOT the Android google-services.json client file.
# Store it outside this repository and the web root; grant only the Laravel
# runtime/queue worker read access. Never put it in mobile, EAS or public storage.
# After manually configuring the server, rebuild Laravel's config cache and
# restart queue workers. Changing .env alone does not update cached config.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS=


GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Initial Super Admin: used only by the explicitly invoked SuperAdminSeeder.
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
